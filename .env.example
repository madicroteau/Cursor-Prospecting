# Required for live web research
# Get a free key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional — Buying Committee names/titles + organization technologies from Apollo
# Create at Apollo → Settings → Integrations → API (master key may be required)
# People search is free; enrichment uses ~1 credit per person (up to 8) + 1 for org tech
# APOLLO_API_KEY=your_apollo_api_key_here

# Optional later — local analysis is used by default (no OpenAI required)
# OPENAI_API_KEY=your_openai_api_key_here
# USE_OPENAI_ANALYSIS=true
# OPENAI_MODEL=gpt-4o-mini
